local Hub = Library.new(Config)
-- everything connected through these is switched off when the hub is closed
Hub.Store = Store
RunService = Hub:Track(RunService)
UIS = Hub:Track(UIS)
local Flags = Hub.Flags
local Elements = {}

-- [1] Infinity jump  (Slider)
table.insert(Elements, {
	Type = "Slider", Name = "Infinity jump ", Tab = "Movement",
	Min = 16, Max = 200, Default = 16, Decimals = 0,
	Callback = function(value)
		-- ==========================================
		-- Infinite Jump Part 1: Slider + Signal
		-- ==========================================
		local Players = game:GetService("Players")
		local UserInputService = game:GetService("UserInputService")
		local CoreGui = game:GetService("CoreGui")
		
		local player = Players.LocalPlayer
		local playerGui = player:WaitForChild("PlayerGui")
		
		_G.InfJumpState = _G.InfJumpState or {
			JumpPower = 50,
			MinJumpPower = 20,
			MaxJumpPower = 180,
			ChangedEvent = Instance.new("BindableEvent")
		}
		
		local State = _G.InfJumpState
		
		local function getGuiParent()
			local env = getfenv()
			local getGuiFn = rawget(env, "gethui")
			if type(getGuiFn) == "function" then
				local ok, gui = pcall(getGuiFn)
				if ok and gui then
					return gui
				end
			end
			local okCore = pcall(function()
				local f = Instance.new("Folder")
				f.Parent = CoreGui
				f:Destroy()
			end)
			return okCore and CoreGui or playerGui
		end
		
		local guiParent = getGuiParent()
		local oldGui = guiParent:FindFirstChild("InfJumpSliderNoToggleGui")
		if oldGui then
			oldGui:Destroy()
		end
		
		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "InfJumpSliderNoToggleGui"
		screenGui.ResetOnSpawn = false
		screenGui.Parent = guiParent
		
		local protectGuiFn = rawget(getfenv(), "protectgui")
		if type(protectGuiFn) == "function" then
			pcall(protectGuiFn, screenGui)
		end
		
		local mainFrame = Instance.new("Frame")
		mainFrame.Size = UDim2.fromOffset(250, 88)
		mainFrame.Position = UDim2.new(0, 20, 0.5, -55)
		mainFrame.BackgroundColor3 = Color3.fromRGB(24, 26, 32)
		mainFrame.BorderSizePixel = 0
		mainFrame.Active = true
		mainFrame.Draggable = true
		mainFrame.Parent = screenGui
		
		Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 10)
		
		local valueLabel = Instance.new("TextLabel")
		valueLabel.Size = UDim2.new(1, -24, 0, 24)
		valueLabel.Position = UDim2.fromOffset(12, 10)
		valueLabel.BackgroundTransparency = 1
		valueLabel.Text = "Infinite Jump Slider: " .. tostring(State.JumpPower)
		valueLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		valueLabel.TextSize = 13
		valueLabel.Font = Enum.Font.GothamBold
		valueLabel.TextXAlignment = Enum.TextXAlignment.Left
		valueLabel.Parent = mainFrame
		
		local sliderTrack = Instance.new("Frame")
		sliderTrack.Size = UDim2.new(1, -24, 0, 10)
		sliderTrack.Position = UDim2.fromOffset(12, 48)
		sliderTrack.BackgroundColor3 = Color3.fromRGB(55, 60, 72)
		sliderTrack.BorderSizePixel = 0
		sliderTrack.Parent = mainFrame
		
		Instance.new("UICorner", sliderTrack).CornerRadius = UDim.new(1, 0)
		
		local sliderFill = Instance.new("Frame")
		sliderFill.Size = UDim2.fromScale(0.2, 1)
		sliderFill.BackgroundColor3 = Color3.fromRGB(88, 166, 255)
		sliderFill.BorderSizePixel = 0
		sliderFill.Parent = sliderTrack
		
		Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)
		
		local sliderKnob = Instance.new("TextButton")
		sliderKnob.Size = UDim2.fromOffset(20, 20)
		sliderKnob.Position = UDim2.new(0.2, -10, 0.5, -10)
		sliderKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		sliderKnob.Text = ""
		sliderKnob.Parent = sliderTrack
		
		Instance.new("UICorner", sliderKnob).CornerRadius = UDim.new(1, 0)
		
		local function updateJumpPower(ratio)
			local clamped = math.clamp(ratio, 0, 1)
			local power = math.floor((State.MinJumpPower + (State.MaxJumpPower - State.MinJumpPower) * clamped) + 0.5)
			State.JumpPower = power
			valueLabel.Text = "Infinite Jump Slider: " .. tostring(power)
			sliderFill.Size = UDim2.fromScale(clamped, 1)
			sliderKnob.Position = UDim2.new(clamped, -10, 0.5, -10)
			State.ChangedEvent:Fire("JumpPower", power)
		end
		
		updateJumpPower((State.JumpPower - State.MinJumpPower) / (State.MaxJumpPower - State.MinJumpPower))
		
		local dragging = false
		
		local function applyInputX(x)
			local posX = sliderTrack.AbsolutePosition.X
			local sizeX = sliderTrack.AbsoluteSize.X
			if sizeX > 0 then
				updateJumpPower((x - posX) / sizeX)
			end
		end
		
		sliderKnob.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				applyInputX(input.Position.X)
			end
		end)
		
		sliderTrack.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				applyInputX(input.Position.X)
			end
		end)
		
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				applyInputX(input.Position.X)
			end
		end)
		
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
		
	end,
})

-- [2] WalkSpeed (Slider)
table.insert(Elements, {
	Type = "Slider", Name = "WalkSpeed", Tab = "Movement",
	Desc = "Run faster",
	Min = 16, Max = 250, Default = 16, Decimals = 0,
	Callback = function(value)
		-- ==========================================
		-- Speed Part 1: Speed Slider + Signal
		-- ==========================================
		local Players = game:GetService("Players")
		local UserInputService = game:GetService("UserInputService")
		local CoreGui = game:GetService("CoreGui")
		
		local player = Players.LocalPlayer
		local playerGui = player:WaitForChild("PlayerGui")
		
		_G.SpeedState = _G.SpeedState or {
			WalkSpeed = 32,
			MinSpeed = 16,
			MaxSpeed = 180,
			ChangedEvent = Instance.new("BindableEvent")
		}
		
		local State = _G.SpeedState
		
		local function getGuiParent()
			local env = getfenv()
			local getGuiFn = rawget(env, "gethui")
			if type(getGuiFn) == "function" then
				local ok, gui = pcall(getGuiFn)
				if ok and gui then
					return gui
				end
			end
			local okCore = pcall(function()
				local f = Instance.new("Folder")
				f.Parent = CoreGui
				f:Destroy()
			end)
			return okCore and CoreGui or playerGui
		end
		
		local guiParent = getGuiParent()
		local oldGui = guiParent:FindFirstChild("SpeedSliderNoToggleGui")
		if oldGui then
			oldGui:Destroy()
		end
		
		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "SpeedSliderNoToggleGui"
		screenGui.ResetOnSpawn = false
		screenGui.Parent = guiParent
		
		local protectGuiFn = rawget(getfenv(), "protectgui")
		if type(protectGuiFn) == "function" then
			pcall(protectGuiFn, screenGui)
		end
		
		local mainFrame = Instance.new("Frame")
		mainFrame.Size = UDim2.fromOffset(250, 88)
		mainFrame.Position = UDim2.new(0, 20, 0.5, -155)
		mainFrame.BackgroundColor3 = Color3.fromRGB(24, 26, 32)
		mainFrame.BorderSizePixel = 0
		mainFrame.Active = true
		mainFrame.Draggable = true
		mainFrame.Parent = screenGui
		
		Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 10)
		
		local valueLabel = Instance.new("TextLabel")
		valueLabel.Size = UDim2.new(1, -24, 0, 24)
		valueLabel.Position = UDim2.fromOffset(12, 10)
		valueLabel.BackgroundTransparency = 1
		valueLabel.Text = "Speed Slider: " .. tostring(State.WalkSpeed)
		valueLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		valueLabel.TextSize = 13
		valueLabel.Font = Enum.Font.GothamBold
		valueLabel.TextXAlignment = Enum.TextXAlignment.Left
		valueLabel.Parent = mainFrame
		
		local sliderTrack = Instance.new("Frame")
		sliderTrack.Size = UDim2.new(1, -24, 0, 10)
		sliderTrack.Position = UDim2.fromOffset(12, 48)
		sliderTrack.BackgroundColor3 = Color3.fromRGB(55, 60, 72)
		sliderTrack.BorderSizePixel = 0
		sliderTrack.Parent = mainFrame
		
		Instance.new("UICorner", sliderTrack).CornerRadius = UDim.new(1, 0)
		
		local sliderFill = Instance.new("Frame")
		sliderFill.Size = UDim2.fromScale(0.1, 1)
		sliderFill.BackgroundColor3 = Color3.fromRGB(88, 166, 255)
		sliderFill.BorderSizePixel = 0
		sliderFill.Parent = sliderTrack
		
		Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)
		
		local sliderKnob = Instance.new("TextButton")
		sliderKnob.Size = UDim2.fromOffset(20, 20)
		sliderKnob.Position = UDim2.new(0.1, -10, 0.5, -10)
		sliderKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		sliderKnob.Text = ""
		sliderKnob.Parent = sliderTrack
		
		Instance.new("UICorner", sliderKnob).CornerRadius = UDim.new(1, 0)
		
		local function updateSpeed(ratio)
			local clamped = math.clamp(ratio, 0, 1)
			local speed = math.floor((State.MinSpeed + (State.MaxSpeed - State.MinSpeed) * clamped) + 0.5)
			State.WalkSpeed = speed
			valueLabel.Text = "Speed Slider: " .. tostring(speed)
			sliderFill.Size = UDim2.fromScale(clamped, 1)
			sliderKnob.Position = UDim2.new(clamped, -10, 0.5, -10)
			State.ChangedEvent:Fire("Speed", speed)
		end
		
		updateSpeed((State.WalkSpeed - State.MinSpeed) / (State.MaxSpeed - State.MinSpeed))
		
		local dragging = false
		
		local function applyInputX(x)
			local posX = sliderTrack.AbsolutePosition.X
			local sizeX = sliderTrack.AbsoluteSize.X
			if sizeX > 0 then
				updateSpeed((x - posX) / sizeX)
			end
		end
		
		sliderKnob.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				applyInputX(input.Position.X)
			end
		end)
		
		sliderTrack.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				applyInputX(input.Position.X)
			end
		end)
		
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				applyInputX(input.Position.X)
			end
		end)
		
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
		
	end,
})

