-- [4] HP (Toggle)
table.insert(Elements, {
	Type = "Toggle", Name = "HP", Tab = "Movement",
	Default = false, Interval = 0.1,
	On = function()
		-- ==========================================
		-- God Health Toggle-Only Part 1: Signal Sender
		-- ==========================================
		local Players = game:GetService("Players")
		
		local player = Players.LocalPlayer
		
		_G.GodHealthToggleOnlyState = _G.GodHealthToggleOnlyState or {
			Enabled = true,
			ChangedEvent = Instance.new("BindableEvent")
		}
		
		local State = _G.GodHealthToggleOnlyState
		
		local function sendToggleSignal(enabled)
			State.Enabled = enabled == true
			State.ChangedEvent:Fire("Toggle", State.Enabled)
		end
		
		_G.SendGodHealthToggle = sendToggleSignal
		
		if player and not State._SentInitial then
			State._SentInitial = true
			sendToggleSignal(State.Enabled)
		end
		
	end,
})

-- [5] Damage  (Toggle)
table.insert(Elements, {
	Type = "Toggle", Name = "Damage ", Tab = "Fun",
	Default = false, Interval = 0.1,
	On = function()
		-- ==========================================
		-- Combat Damage 40 Qi x8 (ฉบับรวม All-in-One)
		-- ดาเมจ: 40 Qi x8 = 320,000,000,000,000,000,000
		-- ส่งสัญญาณไปยัง Server เท่านั้นผ่าน RemoteEvent
		-- ==========================================
		local Players = game:GetService("Players")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local UserInputService = game:GetService("UserInputService")
		local CoreGui = game:GetService("CoreGui")
		
		local player = Players.LocalPlayer
		local playerGui = player:WaitForChild("PlayerGui")
		
		local CONFIG = {
			BaseQi = 40,
			Multiplier = 8,
			DamageDisplay = "40 Qi x8",
			TotalDamage = 320000000000000000000, -- 320,000,000,000,000,000,000
			TotalDamageText = "320,000,000,000,000,000,000",
			RemoteName = "DamageToggleRemote", -- เปลี่ยนให้ตรงกับ RemoteEvent ของเกม
			ToggleKey = Enum.KeyCode.F
		}
		
		local isDamageEnabled = false
		
		-- ค้นหา RemoteEvent สำหรับส่งสัญญาณไปยัง Server
		local function findDamageRemote()
			local direct = ReplicatedStorage:FindFirstChild(CONFIG.RemoteName, true)
			if direct and direct:IsA("RemoteEvent") then
				return direct
			end
		
			for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
				if obj:IsA("RemoteEvent") and string.find(string.lower(obj.Name), "damage") then
					return obj
				end
			end
		
			return nil
		end
		
		local damageRemote = findDamageRemote()
		
		-- เลือก Parent ของ GUI และเลี่ยงคำเตือนใน Wyvern Studio
		local function getGuiParent()
			local env = getfenv()
			local getGuiFn = rawget(env, "gethui")
			if type(getGuiFn) == "function" then
				local ok, gui = pcall(getGuiFn)
				if ok and gui then
					return gui
				end
			end
		
			local okCore = pcall(function()
				local f = Instance.new("Folder")
				f.Parent = CoreGui
				f:Destroy()
			end)
			return okCore and CoreGui or playerGui
		end
		
		local guiParent = getGuiParent()
		local oldGui = guiParent:FindFirstChild("CombatDamageMergedGui")
		if oldGui then
			oldGui:Destroy()
		end
		
		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "CombatDamageMergedGui"
		screenGui.ResetOnSpawn = false
		screenGui.Parent = guiParent
		
		local protectGuiFn = rawget(getfenv(), "protectgui")
		if type(protectGuiFn) == "function" then
			pcall(protectGuiFn, screenGui)
		end
		
		-- สร้าง UI ปุ่มเปิด/ปิดดาเมจ
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromOffset(250, 56)
		frame.Position = UDim2.new(0, 20, 0.5, -155)
		frame.BackgroundColor3 = Color3.fromRGB(24, 26, 32)
		frame.BorderSizePixel = 0
		frame.Active = true
		frame.Draggable = true
		frame.Parent = screenGui
		
		Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
		
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, -90, 1, 0)
		label.Position = UDim2.fromOffset(12, 0)
		label.BackgroundTransparency = 1
		label.Text = "Dmg: " .. CONFIG.DamageDisplay
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.TextSize = 13
		label.Font = Enum.Font.GothamBold
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = frame
		
		local toggleBtn = Instance.new("TextButton")
		toggleBtn.Size = UDim2.fromOffset(66, 32)
		toggleBtn.Position = UDim2.new(1, -78, 0.5, -16)
		toggleBtn.TextSize = 13
		toggleBtn.Font = Enum.Font.GothamBold
		toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		toggleBtn.Parent = frame
		
		Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 7)
		
		local function refreshUi()
			if isDamageEnabled then
				toggleBtn.Text = "ON"
				toggleBtn.BackgroundColor3 = Color3.fromRGB(46, 160, 67)
			else
				toggleBtn.Text = "OFF"
				toggleBtn.BackgroundColor3 = Color3.fromRGB(218, 54, 51)
			end
		end
		
		-- ส่งสัญญาณไปยัง Server เท่านั้น
		local function sendToggleToServer(enabled)
			isDamageEnabled = enabled == true
			refreshUi()
		
			local remote = damageRemote or findDamageRemote()
			damageRemote = remote
			if remote then
				remote:FireServer({
					Action = "SetDamageEnabled",
					Enabled = isDamageEnabled,
					BaseQi = CONFIG.BaseQi,
					Multiplier = CONFIG.Multiplier,
					DamageDisplay = CONFIG.DamageDisplay,
					TotalDamage = CONFIG.TotalDamage,
					TotalDamageText = CONFIG.TotalDamageText
				})
			end
		end
		
		-- รับสถานะยืนยันกลับจาก Server (ถ้า Server ส่งกลับมา)
		if damageRemote then
			damageRemote.OnClientEvent:Connect(function(payload)
				if typeof(payload) == "table" and typeof(payload.Enabled) == "boolean" then
					isDamageEnabled = payload.Enabled
					refreshUi()
				end
			end)
		end
		
		toggleBtn.MouseButton1Click:Connect(function()
			sendToggleToServer(not isDamageEnabled)
		end)
		
		UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then
				return
			end
			if input.KeyCode == CONFIG.ToggleKey then
				sendToggleToServer(not isDamageEnabled)
			end
		end)
		
		refreshUi()
		
	end,
})

-- [6] ESP (Toggle)
table.insert(Elements, {
	Type = "Toggle", Name = "ESP", Tab = "Fun",
	Default = false, Interval = 0.1,
	On = function()
		-- ==========================================
		-- Player ESP (ฉบับรวมสมบูรณ์ All-in-One)
		-- แสดง: กล่องสี่เหลี่ยม + ชื่อผู้เล่น + ระยะทาง (m) + เส้นจากด้านล่างกลางจอ
		-- ==========================================
		local Players = game:GetService("Players")
		local RunService = game:GetService("RunService")
		local CoreGui = game:GetService("CoreGui")
		
		local localPlayer = Players.LocalPlayer
		local playerGui = localPlayer:WaitForChild("PlayerGui")
		local camera = workspace.CurrentCamera
		
		-- ==========================================
		-- 1. สถานะและตัวส่งสัญญาณ (State & Signal)
		-- ==========================================
		_G.EspState = _G.EspState or {
			Enabled = true,
			STUDS_PER_METER = 3.57,
			MaxDistanceMeters = 2000,
			BoxColor = Color3.fromRGB(88, 166, 255),
			TextColor = Color3.fromRGB(255, 255, 255),
			TracerColor = Color3.fromRGB(46, 160, 67),
			ChangedEvent = Instance.new("BindableEvent")
		}
		
		local State = _G.EspState
		
		local function setEspState(enabled)
			State.Enabled = enabled == true
			State.ChangedEvent:Fire("EspEnabled", State.Enabled)
		end
		
		_G.SetEspEnabled = setEspState
		
		-- ==========================================
		-- 2. ระบบวาด ESP (Drawing Renderer)
		-- ==========================================
		local function getDrawingFn()
			local env = getfenv()
			local drawObj = rawget(env, "Drawing")
			if type(drawObj) == "table" and type(drawObj.new) == "function" then
				return drawObj.new
			end
			return nil
		end
		
		local drawingNew = getDrawingFn()
		
		local function createDraw(drawType, props)
			if not drawingNew then
				return nil
			end
			local ok, item = pcall(drawingNew, drawType)
			if not ok or not item then
				return nil
			end
			for k, v in pairs(props) do
				pcall(function()
					item[k] = v
				end)
			end
			return item
		end
		
		local function destroyDraw(item)
			if item then
				pcall(function()
					item.Visible = false
					item:Remove()
				end)
			end
		end
		
		local espEntries = {}
		
		local function createEspEntry(targetPlayer)
			if espEntries[targetPlayer] then
				return espEntries[targetPlayer]
			end
		
			local entry = {
				Box = createDraw("Square", {
					Visible = false,
					Color = State.BoxColor,
					Thickness = 1.6,
					Filled = false
				}),
				Tracer = createDraw("Line", {
					Visible = false,
					Color = State.TracerColor,
					Thickness = 1.5
				}),
				InfoText = createDraw("Text", {
					Visible = false,
					Color = State.TextColor,
					Size = 14,
					Center = true,
					Outline = true
				})
			}
		
			espEntries[targetPlayer] = entry
			return entry
		end
		
		local function removeEspEntry(targetPlayer)
			local entry = espEntries[targetPlayer]
			if not entry then
				return
			end
			destroyDraw(entry.Box)
			destroyDraw(entry.Tracer)
			destroyDraw(entry.InfoText)
			espEntries[targetPlayer] = nil
		end
		
		local function hideEntry(entry)
			if not entry then
				return
			end
			if entry.Box then
				entry.Box.Visible = false
			end
			if entry.Tracer then
				entry.Tracer.Visible = false
			end
			if entry.InfoText then
				entry.InfoText.Visible = false
			end
		end
		
		local function hideAllEsp()
			for _, entry in pairs(espEntries) do
				hideEntry(entry)
			end
		end
		
		local function getCharacterScreenBox(character)
			local root = character:FindFirstChild("HumanoidRootPart")
			if not root then
				return nil
			end
		
			local cf, size = character:GetBoundingBox()
			local halfX = size.X * 0.5
			local halfY = size.Y * 0.5
			local halfZ = size.Z * 0.5
		
			local corners = {
				cf * Vector3.new(-halfX, -halfY, -halfZ),
				cf * Vector3.new(-halfX, -halfY, halfZ),
				cf * Vector3.new(-halfX, halfY, -halfZ),
				cf * Vector3.new(-halfX, halfY, halfZ),
				cf * Vector3.new(halfX, -halfY, -halfZ),
				cf * Vector3.new(halfX, -halfY, halfZ),
				cf * Vector3.new(halfX, halfY, -halfZ),
				cf * Vector3.new(halfX, halfY, halfZ)
			}
		
			local minX, minY = math.huge, math.huge
			local maxX, maxY = -math.huge, -math.huge
			local anyInFront = false
		
			for _, cornerPos in ipairs(corners) do
				local screenPos, onScreen = camera:WorldToViewportPoint(cornerPos)
				if screenPos.Z > 0 then
					anyInFront = true
				end
				if onScreen or screenPos.Z > 0 then
					minX = math.min(minX, screenPos.X)
					maxX = math.max(maxX, screenPos.X)
					minY = math.min(minY, screenPos.Y)
					maxY = math.max(maxY, screenPos.Y)
				end
			end
		
			if not anyInFront or maxX <= minX or maxY <= minY then
				return nil
			end
		
			return Vector2.new(minX, minY), Vector2.new(maxX - minX, maxY - minY), root.Position
		end
		
		-- ==========================================
		-- 3. UI ปุ่มเปิด/ปิด ESP
		-- ==========================================
		local function getGuiParent()
			local env = getfenv()
			local getGuiFn = rawget(env, "gethui")
			if type(getGuiFn) == "function" then
				local ok, gui = pcall(getGuiFn)
				if ok and gui then
					return gui
				end
			end
			local okCore = pcall(function()
				local f = Instance.new("Folder")
				f.Parent = CoreGui
				f:Destroy()
			end)
			return okCore and CoreGui or playerGui
		end
		
		local guiParent = getGuiParent()
		local oldGui = guiParent:FindFirstChild("PlayerEspMergedGui")
		if oldGui then
			oldGui:Destroy()
		end
		
		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "PlayerEspMergedGui"
		screenGui.ResetOnSpawn = false
		screenGui.Parent = guiParent
		
		local protectGuiFn = rawget(getfenv(), "protectgui")
		if type(protectGuiFn) == "function" then
			pcall(protectGuiFn, screenGui)
		end
		
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromOffset(250, 56)
		frame.Position = UDim2.new(0, 20, 0.5, 210)
		frame.BackgroundColor3 = Color3.fromRGB(24, 26, 32)
		frame.BorderSizePixel = 0
		frame.Active = true
		frame.Draggable = true
		frame.Parent = screenGui
		
		Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
		
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, -90, 1, 0)
		label.Position = UDim2.fromOffset(12, 0)
		label.BackgroundTransparency = 1
		label.Text = "ESP (Box/Name/m/Line)"
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.TextSize = 13
		label.Font = Enum.Font.GothamBold
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = frame
		
		local toggleBtn = Instance.new("TextButton")
		toggleBtn.Size = UDim2.fromOffset(66, 32)
		toggleBtn.Position = UDim2.new(1, -78, 0.5, -16)
		toggleBtn.TextSize = 13
		toggleBtn.Font = Enum.Font.GothamBold
		toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		toggleBtn.Parent = frame
		
		Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 7)
		
		local function refreshEspUi()
			if State.Enabled then
				toggleBtn.Text = "ON"
				toggleBtn.BackgroundColor3 = Color3.fromRGB(46, 160, 67)
			else
				toggleBtn.Text = "OFF"
				toggleBtn.BackgroundColor3 = Color3.fromRGB(218, 54, 51)
				hideAllEsp()
			end
		end
		
		State.ChangedEvent.Event:Connect(function(signalType, payload)
			if signalType == "EspEnabled" then
				State.Enabled = payload == true
				refreshEspUi()
			end
		end)
		
		toggleBtn.MouseButton1Click:Connect(function()
			setEspState(not State.Enabled)
		end)
		
		-- ==========================================
		-- 4. ลูปอัปเดตทุกเฟรมและทำความสะอาด
		-- ==========================================
		RunService.RenderStepped:Connect(function()
			camera = workspace.CurrentCamera or camera
			if not State.Enabled or not camera or not drawingNew then
				hideAllEsp()
				return
			end
		
			local myChar = localPlayer.Character
			local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
			local viewportSize = camera.ViewportSize
			local bottomCenter = Vector2.new(viewportSize.X * 0.5, viewportSize.Y)
		
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= localPlayer then
					local entry = createEspEntry(plr)
					local char = plr.Character
					local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		
					if not char or not humanoid or humanoid.Health <= 0 then
						hideEntry(entry)
					else
						local boxPos, boxSize, targetPos = getCharacterScreenBox(char)
						if not boxPos or not boxSize or not targetPos then
							hideEntry(entry)
						else
							local distanceMeters = 0
							if myRoot then
								distanceMeters = (targetPos - myRoot.Position).Magnitude / State.STUDS_PER_METER
							end
		
							if distanceMeters > State.MaxDistanceMeters then
								hideEntry(entry)
							else
								local distInt = math.floor(distanceMeters + 0.5)
								local boxCenterBottom = Vector2.new(boxPos.X + (boxSize.X * 0.5), boxPos.Y + boxSize.Y)
		
								if entry.Box then
									entry.Box.Position = boxPos
									entry.Box.Size = boxSize
									entry.Box.Color = State.BoxColor
									entry.Box.Visible = true
								end
		
								if entry.Tracer then
									entry.Tracer.From = bottomCenter
									entry.Tracer.To = boxCenterBottom
									entry.Tracer.Color = State.TracerColor
									entry.Tracer.Visible = true
								end
		
								if entry.InfoText then
									entry.InfoText.Text = string.format("%s [%dm]", plr.DisplayName, distInt)
									entry.InfoText.Position = Vector2.new(boxPos.X + (boxSize.X * 0.5), boxPos.Y - 18)
									entry.InfoText.Color = State.TextColor
									entry.InfoText.Visible = true
								end
							end
						end
					end
				end
			end
		end)
		
		Players.PlayerRemoving:Connect(function(plr)
			removeEspEntry(plr)
		end)
		
		refreshEspUi()
		
	end,
})

-- [7] Anti-AFK (Toggle)
table.insert(Elements, {
	Type = "Toggle", Name = "Anti-AFK", Tab = "Utility",
	Desc = "Stops the 20 minute idle kick",
	Default = false, Interval = 0.1,
	On = function()
		-- ==========================================
		-- Anti-AFK Only (ไม่มี ESP และไม่มีดาเมจ)
		-- ==========================================
		local Players = game:GetService("Players")
		local VirtualUser = game:GetService("VirtualUser")
		local CoreGui = game:GetService("CoreGui")
		
		local LocalPlayer = Players.LocalPlayer
		local playerGui = LocalPlayer:WaitForChild("PlayerGui")
		
		local Store = _G.WyvernAfkStore or {}
		_G.WyvernAfkStore = Store
		
		local afkEnabled = true
		
		local function enableAntiAfk()
			if Store.afk then
				Store.afk:Disconnect()
				Store.afk = nil
			end
		
			Store.afk = LocalPlayer.Idled:Connect(function()
				if not afkEnabled then
					return
				end
				VirtualUser:CaptureController()
				VirtualUser:ClickButton2(Vector2.new())
			end)
		end
		
		local function disableAntiAfk()
			if Store.afk then
				Store.afk:Disconnect()
				Store.afk = nil
			end
		end
		
		local function setAntiAfkEnabled(enabled)
			afkEnabled = enabled == true
			if afkEnabled then
				enableAntiAfk()
			else
				disableAntiAfk()
			end
		end
		
		local function getGuiParent()
			local env = getfenv()
			local getGuiFn = rawget(env, "gethui")
			if type(getGuiFn) == "function" then
				local ok, gui = pcall(getGuiFn)
				if ok and gui then
					return gui
				end
			end
		
			local okCore = pcall(function()
				local f = Instance.new("Folder")
				f.Parent = CoreGui
				f:Destroy()
			end)
			return okCore and CoreGui or playerGui
		end
		
		local guiParent = getGuiParent()
		local oldGui = guiParent:FindFirstChild("AntiAfkOnlyGui")
		if oldGui then
			oldGui:Destroy()
		end
		
		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "AntiAfkOnlyGui"
		screenGui.ResetOnSpawn = false
		screenGui.Parent = guiParent
		
		local protectGuiFn = rawget(getfenv(), "protectgui")
		if type(protectGuiFn) == "function" then
			pcall(protectGuiFn, screenGui)
		end
		
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromOffset(240, 56)
		frame.Position = UDim2.new(0, 20, 0.5, 0)
		frame.BackgroundColor3 = Color3.fromRGB(24, 26, 32)
		frame.BorderSizePixel = 0
		frame.Active = true
		frame.Draggable = true
		frame.Parent = screenGui
		
		Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
		
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, -90, 1, 0)
		label.Position = UDim2.fromOffset(12, 0)
		label.BackgroundTransparency = 1
		label.Text = "Anti-AFK"
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.TextSize = 13
		label.Font = Enum.Font.GothamBold
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = frame
		
		local toggleBtn = Instance.new("TextButton")
		toggleBtn.Size = UDim2.fromOffset(66, 32)
		toggleBtn.Position = UDim2.new(1, -78, 0.5, -16)
		toggleBtn.TextSize = 13
		toggleBtn.Font = Enum.Font.GothamBold
		toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		toggleBtn.Parent = frame
		
		Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 7)
		
		local function refreshUi()
			if afkEnabled then
				toggleBtn.Text = "ON"
				toggleBtn.BackgroundColor3 = Color3.fromRGB(46, 160, 67)
			else
				toggleBtn.Text = "OFF"
				toggleBtn.BackgroundColor3 = Color3.fromRGB(218, 54, 51)
			end
		end
		
		toggleBtn.MouseButton1Click:Connect(function()
			setAntiAfkEnabled(not afkEnabled)
			refreshUi()
		end)
		
		enableAntiAfk()
		refreshUi()
		
	end,
	Off = function()
		if Store.afk then
		    Store.afk:Disconnect()
		    Store.afk = nil
		end
	end,
})

-- [8] ฟาร์ม (Toggle)
table.insert(Elements, {
	Type = "Toggle", Name = "ฟาร์ม", Tab = "Main",
	Default = false, Interval = 0.1,
	On = function()
		-- ==========================================
		-- Auto Farm Hub (ฉบับรวมทุกฟังก์ชันฟาร์มในที่เดียว)
		-- รวม: Auto Target/Farm + Auto Attack + Auto Collect
		-- ==========================================
		local Players = game:GetService("Players")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local RunService = game:GetService("RunService")
		local CoreGui = game:GetService("CoreGui")
		
		local LocalPlayer = Players.LocalPlayer
		local playerGui = LocalPlayer:WaitForChild("PlayerGui")
		
		local FARM_CONFIG = {
			MasterEnabled = false,
			AutoTarget = true,
			AutoAttack = true,
			AutoCollect = true,
		
			MaxTargetDistance = 400,
			CollectDistance = 80,
			FollowOffset = CFrame.new(0, 0, 5), -- ตำแหน่งยืนเทียบกับเป้าหมาย (เช่น ด้านหลัง/ข้าง 5 studs)
			AttackInterval = 0.15,
			CollectInterval = 0.35,
		
			AttackRemoteName = "AttackRemote", -- เปลี่ยนให้ตรงกับ RemoteEvent โจมตีของเกม
			CollectRemoteName = "CollectRemote", -- เปลี่ยนให้ตรงกับ RemoteEvent เก็บของของเกม
			EnemyFolders = { "Enemies", "Mobs", "Monsters" } -- โฟลเดอร์เป้าหมายใน workspace (ถ้ามี)
		}
		
		local lastAttackTime = 0
		local lastCollectTime = 0
		
		local function findRemoteByName(remoteName, keyword)
			if remoteName and remoteName ~= "" then
				local exact = ReplicatedStorage:FindFirstChild(remoteName, true)
				if exact and exact:IsA("RemoteEvent") then
					return exact
				end
			end
		
			if keyword and keyword ~= "" then
				local lowerKey = string.lower(keyword)
				for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
					if obj:IsA("RemoteEvent") and string.find(string.lower(obj.Name), lowerKey) then
						return obj
					end
				end
			end
		
			return nil
		end
		
		local attackRemote = findRemoteByName(FARM_CONFIG.AttackRemoteName, "attack")
		local collectRemote = findRemoteByName(FARM_CONFIG.CollectRemoteName, "collect")
		
		local function getCharacterParts()
			local char = LocalPlayer.Character
			if not char then
				return nil, nil, nil
			end
			local hum = char:FindFirstChildOfClass("Humanoid")
			local root = char:FindFirstChild("HumanoidRootPart")
			if not hum or not root or hum.Health <= 0 then
				return nil, nil, nil
			end
			return char, hum, root
		end
		
		local function isValidTargetModel(model, rootPos)
			if not model or not model:IsA("Model") then
				return false
			end
			if model == LocalPlayer.Character then
				return false
			end
			if Players:GetPlayerFromCharacter(model) then
				return false
			end
		
			local hum = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
			if not hum or not root or hum.Health <= 0 then
				return false
			end
		
			local dist = (root.Position - rootPos).Magnitude
			if dist > FARM_CONFIG.MaxTargetDistance then
				return false
			end
		
			return true, root, hum, dist
		end
		
		-- ค้นหาเป้าหมายฟาร์มที่ใกล้ที่สุด
		local function findNearestTarget(rootPos)
			local bestModel = nil
			local bestRoot = nil
			local bestHum = nil
			local bestDist = math.huge
		
			local searchRoots = {}
			for _, folderName in ipairs(FARM_CONFIG.EnemyFolders) do
				local folder = workspace:FindFirstChild(folderName)
				if folder then
					table.insert(searchRoots, folder)
				end
			end
			if #searchRoots == 0 then
				table.insert(searchRoots, workspace)
			end
		
			for _, container in ipairs(searchRoots) do
				for _, desc in ipairs(container:GetDescendants()) do
					if desc:IsA("Model") then
						local ok, tRoot, tHum, dist = isValidTargetModel(desc, rootPos)
						if ok and dist < bestDist then
							bestDist = dist
							bestModel = desc
							bestRoot = tRoot
							bestHum = tHum
						end
					end
				end
			end
		
			return bestModel, bestRoot, bestHum
		end
		
		-- ฟังก์ชัน Auto Attack
		local function runAutoAttack(targetModel, targetRoot, root)
			if not FARM_CONFIG.AutoAttack then
				return
			end
			local now = os.clock()
			if now - lastAttackTime < FARM_CONFIG.AttackInterval then
				return
			end
			lastAttackTime = now
		
			local remote = attackRemote or findRemoteByName(FARM_CONFIG.AttackRemoteName, "attack")
			attackRemote = remote
		
			if remote then
				pcall(function()
					remote:FireServer({
						Action = "AutoFarmAttack",
						Target = targetModel,
						TargetPosition = targetRoot and targetRoot.Position or nil
					})
				end)
			end
		
			local char = LocalPlayer.Character
			local tool = char and char:FindFirstChildOfClass("Tool")
			if tool and tool:FindFirstChild("Activate") then
				pcall(function()
					tool:Activate()
				end)
			elseif root then
				-- รองรับกรณีเกมใช้การโจมตีผ่าน input/tool ปกติ
				pcall(function()
					if tool then
						tool:Activate()
					end
				end)
			end
		end
		
		-- ฟังก์ชัน Auto Collect
		local function runAutoCollect(char, root)
			if not FARM_CONFIG.AutoCollect then
				return
			end
			local now = os.clock()
			if now - lastCollectTime < FARM_CONFIG.CollectInterval then
				return
			end
			lastCollectTime = now
		
			local remote = collectRemote or findRemoteByName(FARM_CONFIG.CollectRemoteName, "collect")
			collectRemote = remote
		
			for _, obj in ipairs(workspace:GetDescendants()) do
				if obj:IsA("BasePart") and obj:FindFirstChildOfClass("TouchTransmitter") then
					local dist = (obj.Position - root.Position).Magnitude
					if dist <= FARM_CONFIG.CollectDistance then
						if remote then
							pcall(function()
								remote:FireServer(obj)
							end)
						end
						if typeof(firetouchinterest) == "function" then
							pcall(function()
								firetouchinterest(root, obj, 0)
								firetouchinterest(root, obj, 1)
							end)
						end
					end
				end
			end
		end
		
		-- ==========================================
		-- UI ฉบับรวมของระบบฟาร์ม
		-- ==========================================
		local function getGuiParent()
			local env = getfenv()
			local getGuiFn = rawget(env, "gethui")
			if type(getGuiFn) == "function" then
				local ok, gui = pcall(getGuiFn)
				if ok and gui then
					return gui
				end
			end
		
			local okCore = pcall(function()
				local f = Instance.new("Folder")
				f.Parent = CoreGui
				f:Destroy()
			end)
			return okCore and CoreGui or playerGui
		end
		
		local guiParent = getGuiParent()
		local oldGui = guiParent:FindFirstChild("AutoFarmHubGui")
		if oldGui then
			oldGui:Destroy()
		end
		
		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "AutoFarmHubGui"
		screenGui.ResetOnSpawn = false
		screenGui.Parent = guiParent
		
		local protectGuiFn = rawget(getfenv(), "protectgui")
		if type(protectGuiFn) == "function" then
			pcall(protectGuiFn, screenGui)
		end
		
		local mainFrame = Instance.new("Frame")
		mainFrame.Size = UDim2.fromOffset(265, 224)
		mainFrame.Position = UDim2.new(0, 20, 0.5, -112)
		mainFrame.BackgroundColor3 = Color3.fromRGB(24, 26, 32)
		mainFrame.BorderSizePixel = 0
		mainFrame.Active = true
		mainFrame.Draggable = true
		mainFrame.Parent = screenGui
		
		Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 10)
		
		local titleLabel = Instance.new("TextLabel")
		titleLabel.Size = UDim2.new(1, -24, 0, 28)
		titleLabel.Position = UDim2.fromOffset(12, 8)
		titleLabel.BackgroundTransparency = 1
		titleLabel.Text = "Auto Farm Hub (All-in-One)"
		titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		titleLabel.TextSize = 13
		titleLabel.Font = Enum.Font.GothamBold
		titleLabel.TextXAlignment = Enum.TextXAlignment.Left
		titleLabel.Parent = mainFrame
		
		local function makeToggleRow(yPos, text)
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -24, 0, 38)
			row.Position = UDim2.fromOffset(12, yPos)
			row.BackgroundColor3 = Color3.fromRGB(34, 38, 48)
			row.BorderSizePixel = 0
			row.Parent = mainFrame
		
			Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
		
			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.new(1, -86, 1, 0)
			lbl.Position = UDim2.fromOffset(10, 0)
			lbl.BackgroundTransparency = 1
			lbl.Text = text
			lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
			lbl.TextSize = 12
			lbl.Font = Enum.Font.GothamBold
			lbl.TextXAlignment = Enum.TextXAlignment.Left
			lbl.Parent = row
		
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.fromOffset(64, 26)
			btn.Position = UDim2.new(1, -74, 0.5, -13)
			btn.TextSize = 12
			btn.Font = Enum.Font.GothamBold
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.Parent = row
		
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
		
			return btn
		end
		
		local masterBtn = makeToggleRow(42, "Master Auto Farm")
		local targetBtn = makeToggleRow(86, "Auto Target / Follow")
		local attackBtn = makeToggleRow(130, "Auto Attack")
		local collectBtn = makeToggleRow(174, "Auto Collect")
		
		local function paintBtn(btn, state)
			if state then
				btn.Text = "ON"
				btn.BackgroundColor3 = Color3.fromRGB(46, 160, 67)
			else
				btn.Text = "OFF"
				btn.BackgroundColor3 = Color3.fromRGB(218, 54, 51)
			end
		end
		
		local function syncFarmUi()
			paintBtn(masterBtn, FARM_CONFIG.MasterEnabled)
			paintBtn(targetBtn, FARM_CONFIG.AutoTarget)
			paintBtn(attackBtn, FARM_CONFIG.AutoAttack)
			paintBtn(collectBtn, FARM_CONFIG.AutoCollect)
		end
		
		masterBtn.MouseButton1Click:Connect(function()
			FARM_CONFIG.MasterEnabled = not FARM_CONFIG.MasterEnabled
			syncFarmUi()
		end)
		
		targetBtn.MouseButton1Click:Connect(function()
			FARM_CONFIG.AutoTarget = not FARM_CONFIG.AutoTarget
			syncFarmUi()
		end)
		
		attackBtn.MouseButton1Click:Connect(function()
			FARM_CONFIG.AutoAttack = not FARM_CONFIG.AutoAttack
			syncFarmUi()
		end)
		
		collectBtn.MouseButton1Click:Connect(function()
			FARM_CONFIG.AutoCollect = not FARM_CONFIG.AutoCollect
			syncFarmUi()
		end)
		
		-- ลูปทำงานหลักของระบบฟาร์ม
		RunService.Heartbeat:Connect(function()
			if not FARM_CONFIG.MasterEnabled then
				return
			end
		
			local char, hum, root = getCharacterParts()
			if not char or not hum or not root then
				return
			end
		
			local targetModel, targetRoot = nil, nil
			if FARM_CONFIG.AutoTarget then
				targetModel, targetRoot = findNearestTarget(root.Position)
				if targetModel and targetRoot then
					local desiredCFrame = targetRoot.CFrame * FARM_CONFIG.FollowOffset
					root.CFrame = CFrame.lookAt(desiredCFrame.Position, targetRoot.Position)
				end
			end
		
			runAutoAttack(targetModel, targetRoot, root)
			runAutoCollect(char, root)
		end)
		
		syncFarmUi()
		
	end,
})

Hub:Build(Elements, { "Main", "Movement", "Visual", "Utility", "Fun" })
return Hub
